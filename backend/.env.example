DATABASE_URL=postgresql+psycopg://repomind:repomind@localhost:5432/repomind
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=

CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
VERIFY_MODEL=gpt-4o-mini

GITHUB_TOKEN=
REVIEW_DEBUG_ENABLED=false
REVIEW_CONTEXT_MODE=full

# GitHub App (webhook-driven reviews; see README "GitHub App integration & benchmark")
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_REVIEW_FORKS=false
GITHUB_MAX_INLINE_COMMENTS=10
GITHUB_RATE_LIMIT_CAPACITY=5
GITHUB_RATE_LIMIT_REFILL_PER_MINUTE=5.0
REVIEW_DRY_RUN=true

# Dashboard API (see README "Dashboard API"). Fails closed: if DASHBOARD_API_KEY is
# unset, every route except /webhooks/github and /health returns 503.
DASHBOARD_API_KEY=
# Local-dev-only opt-out that disables auth entirely. Refused at startup unless
# REVIEW_DRY_RUN=true and GITHUB_WEBHOOK_SECRET is unset.
DASHBOARD_AUTH_DISABLED=false
CORS_ALLOWED_ORIGINS=

# Optional LangSmith tracing (see README "Observability"). Off by default.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=repomind
LANGCHAIN_ENDPOINT=
