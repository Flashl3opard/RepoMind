# Root env file for `docker compose up --build` (the one-command full stack: db +
# backend + frontend). Copy this to .env and fill in what you need, then run:
#
#   cp .env.example .env
#   docker compose up --build
#   uv run --project backend python scripts/seed_demo.py   # optional, see its --help
#
# Everything below has a working default except the two marked REQUIRED -- the stack
# starts without them, but ingestion/Q&A/review need a real embedding+chat provider
# key to do anything beyond returning errors.

# -- Embedding + chat provider (REQUIRED: at least one of the two API keys below) ----
EMBEDDING_PROVIDER=openai
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
VERIFY_MODEL=gpt-4o-mini
# REQUIRED if EMBEDDING_PROVIDER/CHAT_PROVIDER=openai
OPENAI_API_KEY=
# REQUIRED instead, if you set EMBEDDING_PROVIDER/CHAT_PROVIDER=google
GOOGLE_API_KEY=

# -- GitHub (all optional for local use) ---------------------------------------------
# A personal access token: higher API rate limits, and required for reviewing a
# private repo's PR by URL (POST /repos/{id}/review with pr_url, no GitHub App).
GITHUB_TOKEN=
# diff_only structurally can't produce breaking_change/contract_change findings (see
# backend/README.md); naive is the fair baseline; full (default) is the real pipeline.
REVIEW_CONTEXT_MODE=full
# Keep this true unless you've set up a real GitHub App below -- it's what stops a
# review from actually posting a comment to a real pull request.
REVIEW_DRY_RUN=true

# -- GitHub App (optional: only needed for webhook-driven automatic reviews) ---------
# See backend/README.md's "GitHub App integration" section for how to create one.
GITHUB_APP_ID=
# Paste the App's private key PEM content as a single line with literal \n for
# newlines (pydantic-settings reads \n in an env value as a real newline), e.g.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEvQ...\n-----END RSA PRIVATE KEY-----"
# -- or leave this blank, mount the actual .pem file into the backend container
# instead (see the commented-out `volumes:` entry on the backend service in
# docker-compose.yml), and point this at that mounted path. Either way, the key is
# never baked into the image.
GITHUB_APP_PRIVATE_KEY=
# Shared secret GitHub signs webhook deliveries with; required for /webhooks/github
# to accept anything. Leave blank if you're not using the GitHub App.
GITHUB_WEBHOOK_SECRET=
GITHUB_REVIEW_FORKS=false

# -- Dashboard API auth (backend/app/api/dashboard_auth.py) --------------------------
# Change this if the stack will be reachable by anyone but you; the dashboard
# container already has it wired through automatically, so it just needs to be
# non-empty for both sides to agree.
DASHBOARD_API_KEY=local-dev-key
# Explicit opt-out instead of a key, for local dev only -- startup refuses it unless
# REVIEW_DRY_RUN=true and GITHUB_WEBHOOK_SECRET is unset. Leave false; the default
# DASHBOARD_API_KEY above already makes this unnecessary for local use.
DASHBOARD_AUTH_DISABLED=false
# Comma-separated browser origins allowed to call the backend directly. Not needed
# for the bundled frontend (it calls the backend server-side), only if you're
# building your own browser client against this API.
CORS_ALLOWED_ORIGINS=
